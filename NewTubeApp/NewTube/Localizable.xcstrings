          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube временно блокирует эту сеть. Отключите VPN, выберите другой VPN-сервер или подождите несколько минут и повторите попытку."
          }
        },
        "sr" : {
          "stringUnit" : {
