    "YouTube is temporarily blocking this network. Disable your VPN, try a different VPN server, or wait a few minutes and retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube blockiert dieses Netzwerk vorübergehend. Deaktiviere dein VPN, probiere einen anderen VPN-Server oder warte ein paar Minuten und versuche es dann noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
