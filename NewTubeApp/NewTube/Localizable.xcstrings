    "The feed took too long to load. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Feed hat zu lange geladen. Prüfe deine Verbindung und versuche es noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux a mis trop de temps à charger. Vérifiez votre connexion et réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El feed ha tardado demasiado en cargarse. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feed impiega troppo a caricarsi. Controlla la connessione e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O feed demorou demais para carregar. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лента загружается слишком долго. Проверьте подключение и повторите попытку."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитавање фида траје предуго. Проверите везу и покушајте поново."
